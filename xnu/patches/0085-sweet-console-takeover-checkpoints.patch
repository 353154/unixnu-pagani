diff --git a/osfmk/arm/io_map.c b/osfmk/arm/io_map.c
--- a/osfmk/arm/io_map.c
+++ b/osfmk/arm/io_map.c
@@ -60,6 +60,8 @@
 #include <arm/pmap.h>
 #include <san/kasan.h>
 
+extern void kprintf(const char *fmt, ...);
+
 extern vm_offset_t virtual_space_start;     /* Next available kernel VA */
 
 #define IO_MAP_SIZE            (8ul << 20)
@@ -96,6 +98,10 @@
 	vm_offset_t alloc_size   = round_page(size + start_offset);
 	vm_offset_t start;
 
+	kprintf("SWE00 io_map ph=%lx sz=%lx alloc=%lx phase=%d\n",
+	    (unsigned long)phys_addr, (unsigned long)size,
+	    (unsigned long)alloc_size, (int)startup_phase);
+
 	phys_addr = trunc_page(phys_addr);
 
 	if (startup_phase < STARTUP_SUB_KMEM) {
@@ -125,9 +131,12 @@
 			kmaflags |= KMA_PERMANENT;
 		}
 
+		kprintf("SWE01 kmem_alloc in sz=%lx\n", (unsigned long)alloc_size);
 		kmem_alloc(unmappable ? kernel_map : io_submap,
 		    &start, alloc_size, kmaflags, VM_KERN_MEMORY_IOKIT);
+		kprintf("SWE02 kmem_alloc out start=%lx\n", (unsigned long)start);
 		pmap_map(start, phys_addr, phys_addr + alloc_size, prot, flags);
+		kprintf("SWE03 pmap_map done\n");
 	}
 	return start + start_offset;
 }

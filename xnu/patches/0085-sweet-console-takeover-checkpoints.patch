 		}
@@ -2921,7 +2927,9 @@
 			gc_ops.hide_cursor  = vc_reverse_cursor;
 			gc_ops.show_cursor  = vc_reverse_cursor;
 			gc_ops.update_color = vc_update_color;
+			kprintf("SWD03 gc_initialize in\n");
 			gc_initialize(&vinfo);
+			kprintf("SWD04 gc_initialize out\n");
 		}
 	}
 
@@ -2959,9 +2967,12 @@
 		}
 
 #if !defined(XNU_TARGET_OS_BRIDGE)
+		kprintf("SWD05 vc_progress_set delay=%d gfx=%d\n", delay, graphics_now);
 		vc_progress_set( graphics_now, delay );
 #endif /* !defined(XNU_TARGET_OS_BRIDGE) */
+		kprintf("SWD06 gc_enable in\n");
 		gc_enable( !graphics_now );
+		kprintf("SWD07 gc_acquired\n");
 		gc_acquired = TRUE;
 		gc_desire_text = FALSE;
 		break;

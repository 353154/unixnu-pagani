+	add		x2, x2, x4
+	subs	x3, x3, #1
+	b.ne	203b
+	add		x1, x1, #(24 * 4)
+	subs	x8, x8, #1
+	b.pl	201b
+	ret
+
+	.align 4
+	.globl EXT(sweet_kva_probe)
+LEXT(sweet_kva_probe)
+	/* Clear PAN to guarantee EL1 can write to identity-mapped framebuffer */
+	msr		pan, #0
+	isb		sy
+
+	/*
+	 * CP6A: We are now running via TTBR1 in KVA space!
+	 * Paint a huge 100x100 bright cyan block at row 520, col 300.
+	 * Absolutely NO stack operations, NO memory allocations, purely register-based!
+	 */
+	MOV64	x1, (0xfc800000 + 520 * 4864 + 300 * 4)
+	MOV64	x2, 0xff00ffff		// Bright Cyan (0x00FFFF)
+	mov		x4, #4864
+	mov		x3, #100
+301:
+	mov		x5, #100
+	mov		x6, x1
+302:
+	str		w2, [x6], #4
+	subs	x5, x5, #1
+	b.ne	302b
+	add		x1, x1, x4
+	subs	x3, x3, #1
+	b.ne	301b
+	dsb		sy
+
+	/*
+	 * CP6B: Now test stack write via KVA!
+	 * SP was set to intstack_top (0xfffffe00080b4000).
+	 * Let's test a simple push and pop.
+	 */
+	sub		sp, sp, #32
+	str		x28, [sp]
+	ldr		x3, [sp]
+	add		sp, sp, #32
+	/* If stack write survived, paint a bright pink 60x60 block right next to it! */
+	MOV64	x1, (0xfc800000 + 520 * 4864 + 420 * 4)
+	MOV64	x2, 0xffff00ff		// Bright Magenta (0xFF00FF)
+	mov		x4, #4864
+	mov		x3, #60
+303:
+	mov		x5, #60
+	mov		x6, x1
+304:
+	str		w2, [x6], #4
+	subs	x5, x5, #1
+	b.ne	304b
+	add		x1, x1, x4
+	subs	x3, x3, #1
+	b.ne	303b
+	dsb		sy
+
+	/* Now proceed to C arm_init */
+	mov		x0, x28
+	adrp	x30, EXT(arm_init)@page
+	add		x30, x30, EXT(arm_init)@pageoff
+	br		x30
+#endif /* SWEET */
+
 //#include	"globals_asm.h"
 

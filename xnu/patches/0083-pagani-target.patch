diff --git a/pexpert/pexpert/arm64/PAGANI.h b/pexpert/pexpert/arm64/PAGANI.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/PAGANI.h
@@ -0,0 +1,15 @@
+/*
+ * Board config for OnePlus 13s / 13T ("pagani", Qualcomm SM8750 /
+ * Snapdragon 8 Elite): 8x Qualcomm Oryon cores, ARMv8.7-A baseline, no PAC.
+ * Inherits common Snapdragon SoC platform drivers from SWEET.
+ */
+
+#ifndef _PEXPERT_ARM64_PAGANI_H
+#define _PEXPERT_ARM64_PAGANI_H
+
+#define PAGANI 1
+
+/* Reuse base definitions from SWEET */
+#include <pexpert/arm64/SWEET.h>
+
+#endif /* ! _PEXPERT_ARM64_PAGANI_H */
diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -108,6 +108,17 @@
 
 #endif  /* ARM64_BOARD_CONFIG_SWEET */
 
+#ifdef ARM64_BOARD_CONFIG_PAGANI
+#include <pexpert/arm64/PAGANI.h>
+
+#define MAX_L2_CLINE                   6
+#define MAX_CPUS                       8
+#define MAX_CPU_CLUSTERS               2
+
+#define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
+
+#endif  /* ARM64_BOARD_CONFIG_PAGANI */
+
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
 
